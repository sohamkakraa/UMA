# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/_tmp-testing-agent

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Prism (auto-generated, machine-specific)
.claude/settings.local.json
.claude/prism.md
.claude/skills/
.claude/.prism_project_id
.claude/worktrees/

# Eval run outputs (keep harness + dataset, not per-run snapshots)
eval-runs/run-*/
eval-runs/run-v*/

# Murphy raw screenshot frames (commit only the summary JSON)
murphy/output/**/frames/

# Swift Package Manager build products (216 MB of checkouts and object files under
# ios-app/UMAShared/.build). Package.resolved is committed; the build tree is not.
ios-app/**/.build/
# The rule above is root-anchored (/node_modules), which left mobile/node_modules — 1.8 GB
# of React Native dependencies incl. 200 MB of prebuilt Skia archives — stageable by a broad
# `git add -A` in this public repo. Unanchored, so it matches at any depth.
node_modules/

# Playwright HTML report: a per-run artifact regenerated by `npx playwright test`.
/playwright-report/
